generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Hospital
// ─────────────────────────────────────────────────────────────────────────────

model Hospital {
  id        String   @id @default(uuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors Doctor[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Doctor
// ─────────────────────────────────────────────────────────────────────────────

model Doctor {
  id             String  @id @default(uuid())
  name           String
  specialization String
  calendarEmail  String?
  hospitalId     String

  hospital Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  bookings Booking[]
  slots    Slot[]

  @@index([hospitalId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Slot  (pre-defined available time windows per doctor)
// ─────────────────────────────────────────────────────────────────────────────

model Slot {
  id       String   @id @default(uuid())
  doctorId String
  startAt  DateTime
  endAt    DateTime
  isBooked Boolean  @default(false)

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, startAt])
  @@index([doctorId, startAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User  (authenticated patients)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  bookings Booking[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Booking
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id           String        @id @default(uuid())
  // Patient details (stored directly — userId is optional for guest bookings)
  name         String
  patientEmail String
  problem      String
  prescription String?

  // Scheduling
  date     DateTime
  meetLink String

  // Status lifecycle
  status BookingStatus @default(UPCOMING)

  // Recall.ai bot integration
  recallBotId String?
  transcript  String? // Raw transcript text from Recall.ai
  summary     String? // AI-generated consultation summary

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId   String? // null for guest (unauthenticated) bookings
  doctorId String

  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, date])
  @@index([patientEmail])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum BookingStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
