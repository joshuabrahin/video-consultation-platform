generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Hospital {
  id        Int      @id @default(autoincrement())
  name      String
  location  String
  createdAt DateTime @default(now())
  doctors   Doctor[]
}

model Doctor {
  id             Int       @id @default(autoincrement())
  name           String
  specialization String
  calendarId     String?
  hospitalId     Int
  hospital       Hospital  @relation(fields: [hospitalId], references: [id])
  bookings       Booking[]
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  email    String    @unique
  password String
  bookings Booking[]
}

model Booking {
  id           Int           @id @default(autoincrement())
  name         String
  patientEmail String?
  problem      String
  prescription String?
  date         DateTime
  meetLink     String
  status       BookingStatus @default(UPCOMING)
  recallBotId  String?
  transcript   String?
  summary      String?
  userId       Int?
  doctorId     Int
  user         User?         @relation(fields: [userId], references: [id])
  doctor       Doctor        @relation(fields: [doctorId], references: [id])

  @@index([doctorId, date])
  @@index([patientEmail])
}

enum BookingStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
